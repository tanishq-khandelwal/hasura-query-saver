{
  "manifest_version": 3,
  "name": "Query Saver for Hasura GraphiQL",
  "version": "1.0.0",
  "description": "Save, re-apply, and share queries, variables, and headers on Hasura's public GraphiQL. Unofficial, not affiliated with Hasura.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Query Saver for Hasura GraphiQL",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "https://cloud.hasura.io/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://cloud.hasura.io/public/graphiql*"
      ],
      "js": [
        "src/content-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://cloud.hasura.io/public/graphiql*"
      ],
      "js": [
        "src/content-isolated.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
